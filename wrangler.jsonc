{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "macanaliz-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./Public/Public/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  
  },
  "kv_namespaces": [
    {
      "binding": "MACANALIZ_CACHE",
      "id": "7c1e5ba24ec5438c9c6400f57d31d4f0"
    }
  ]
}
